[Unit]
Description=Clawd Usage Sync (Anthropic OAuth -> relay)
After=network-online.target clawd-relay.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/clawd-sync
ExecStart=/usr/bin/python3 /home/pi/clawd-sync/usage_sync.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
